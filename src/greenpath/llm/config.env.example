# Nonsecret selected configuration. Keep API credentials out of this file.
# Selection does not mean live availability or quality has been evaluated.
GREENPATH_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_MODEL_VERSION=gpt-4.1-mini-2025-04-14
PROMPT_VERSION=grounded-selection-v1
TEMPERATURE=0
MAX_OUTPUT_TOKENS=1600
# Set GREENPATH_LLM_API_KEY in your environment or secret manager only when authorized.
# Populate these from the provider's CURRENT pricing, in your chosen currency.
# Empty prices intentionally prevent the optional live evaluator from running.
GREENPATH_LLM_INPUT_PRICE_PER_MILLION=
GREENPATH_LLM_OUTPUT_PRICE_PER_MILLION=
GREENPATH_LLM_CACHED_INPUT_PRICE_PER_MILLION=
