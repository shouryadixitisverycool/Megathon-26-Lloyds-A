{
  "$defs": {
    "ConfidenceBucket": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "ConfidenceBucket",
      "type": "string"
    },
    "ConfidenceResult": {
      "additionalProperties": false,
      "description": "Validated reliability of a displayed propensity (spec 16). Not eligibility.",
      "properties": {
        "bucket": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceBucket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConfidenceStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status",
        "method_version"
      ],
      "title": "ConfidenceResult",
      "type": "object"
    },
    "ConfidenceStatus": {
      "enum": [
        "VALIDATED",
        "SUPPRESSED"
      ],
      "title": "ConfidenceStatus",
      "type": "string"
    },
    "ModelType": {
      "enum": [
        "HEURISTIC",
        "LOGISTIC",
        "GRADIENT_BOOSTING"
      ],
      "title": "ModelType",
      "type": "string"
    },
    "PopulationExclusion": {
      "enum": [
        "ALREADY_HOLDS_PRODUCT",
        "ALREADY_PAPERLESS",
        "EXISTING_SOLAR"
      ],
      "title": "PopulationExclusion",
      "type": "string"
    },
    "Product": {
      "enum": [
        "EV_FINANCE",
        "GREEN_HOME",
        "SOLAR_FINANCE",
        "PAPERLESS_BANKING"
      ],
      "title": "Product",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "HIGH_FUEL_SPEND",
        "HIGH_ANNUAL_MILEAGE",
        "ICE_VEHICLE_OWNER",
        "OLDER_VEHICLE",
        "HIGH_ELECTRICITY_USE",
        "HOMEOWNER",
        "MORTGAGE_CUSTOMER",
        "NO_EXISTING_SOLAR",
        "PAPER_STATEMENTS_ACTIVE",
        "HIGH_DIGITAL_ENGAGEMENT",
        "RECENT_HOME_IMPROVEMENT_SPEND",
        "UTILITY_SPEND_RISING",
        "EXISTING_VEHICLE_FINANCE",
        "HIGH_GAS_USE",
        "STATED_SUSTAINABILITY_PREFERENCE"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Calibrated take-up probability for one customer x product.\n\nPropensity estimates interest only. It does not estimate impact or eligibility.",
  "properties": {
    "calibration_method": {
      "title": "Calibration Method",
      "type": "string"
    },
    "calibration_version": {
      "title": "Calibration Version",
      "type": "string"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceResult"
    },
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "customer_id": {
      "title": "Customer Id",
      "type": "string"
    },
    "evidence": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Evidence",
      "type": "object"
    },
    "feature_cutoff": {
      "format": "date",
      "title": "Feature Cutoff",
      "type": "string"
    },
    "feature_version": {
      "title": "Feature Version",
      "type": "string"
    },
    "in_model_population": {
      "title": "In Model Population",
      "type": "boolean"
    },
    "model_type": {
      "$ref": "#/$defs/ModelType"
    },
    "model_version": {
      "title": "Model Version",
      "type": "string"
    },
    "outcome_window_end": {
      "format": "date",
      "title": "Outcome Window End",
      "type": "string"
    },
    "population_exclusion": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopulationExclusion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prediction_timestamp": {
      "format": "date-time",
      "title": "Prediction Timestamp",
      "type": "string"
    },
    "product": {
      "$ref": "#/$defs/Product"
    },
    "propensity": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Propensity",
      "type": "number"
    },
    "raw_score": {
      "title": "Raw Score",
      "type": "number"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    }
  },
  "required": [
    "customer_id",
    "product",
    "propensity",
    "raw_score",
    "model_type",
    "model_version",
    "calibration_method",
    "calibration_version",
    "feature_version",
    "feature_cutoff",
    "outcome_window_end",
    "prediction_timestamp",
    "in_model_population",
    "confidence"
  ],
  "title": "PropensityResult",
  "type": "object"
}
