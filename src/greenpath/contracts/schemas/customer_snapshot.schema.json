        "has_vehicle": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Vehicle"
        },
        "has_vehicle_finance": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
