{
  "$defs": {
    "DataQualityEvidence": {
      "additionalProperties": false,
      "properties": {
        "digital_months_present": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Digital Months Present",
          "type": "integer"
        },
        "energy_months_present": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Energy Months Present",
          "type": "integer"
        },
        "estimated_fields": {
          "items": {
            "type": "string"
          },
          "title": "Estimated Fields",
          "type": "array"
        },
        "first_transaction_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Transaction Date"
        },
        "invalid_product_records": {
          "default": 0,
          "minimum": 0,
          "title": "Invalid Product Records",
          "type": "integer"
        },
        "last_transaction_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Transaction Date"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "transaction_months_observed": {
          "minimum": 0,
          "title": "Transaction Months Observed",
          "type": "integer"
        },
        "vehicle_record_age_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Record Age Days"
        }
      },
      "required": [
        "transaction_months_observed"
      ],
      "title": "DataQualityEvidence",
      "type": "object"
    },
    "DigitalFacts": {
      "additionalProperties": false,
      "properties": {
        "branch_visits_3m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch Visits 3M"
        },
        "digital_statement_ratio": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digital Statement Ratio"
        },
        "digital_transactions_3m_avg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digital Transactions 3M Avg"
        },
        "is_paperless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Paperless"
        },
        "paper_statements_12m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Statements 12M"
        },
        "paper_statements_3m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Statements 3M"
        }
      },
      "title": "DigitalFacts",
      "type": "object"
    },
    "EnergyFacts": {
      "additionalProperties": false,
      "description": "Metered household energy over the 12 months up to the cutoff.",
      "properties": {
        "electricity_kwh_12m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electricity Kwh 12M"
        },
        "electricity_trend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electricity Trend"
        },
        "energy_months_present": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Energy Months Present",
          "type": "integer"
        },
        "gas_kwh_12m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gas Kwh 12M"
        }
      },
      "title": "EnergyFacts",
      "type": "object"
    },
    "FuelType": {
      "enum": [
        "PETROL",
        "DIESEL",
        "HYBRID",
        "EV"
      ],
      "title": "FuelType",
      "type": "string"
    },
    "HeatingType": {
      "enum": [
        "GAS_BOILER",
        "ELECTRIC",
        "OIL",
        "HEAT_PUMP"
      ],
      "title": "HeatingType",
      "type": "string"
    },
    "HomeFacts": {
      "additionalProperties": false,
      "properties": {
        "has_existing_solar": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Existing Solar"
        },
        "has_mortgage": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Has Mortgage"
        },
        "heating_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/HeatingType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "home_owner": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Owner"
        },
        "mortgage_tenure_months": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mortgage Tenure Months"
        },
        "property_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Type"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "title": "HomeFacts",
      "type": "object"
    },
    "SpendFacts": {
      "additionalProperties": false,
      "description": "Aggregated categorised transaction spend in GBP (debits only).\n\n``None`` means no transaction history at the cutoff (unknown), never zero spend.",
      "properties": {
        "electricity_spend_90d_monthly_avg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electricity Spend 90D Monthly Avg"
        },
        "fuel_spend_90d_monthly_avg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fuel Spend 90D Monthly Avg"
        },
        "fuel_txn_frequency_90d": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fuel Txn Frequency 90D"
        },
        "gas_spend_90d_monthly_avg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gas Spend 90D Monthly Avg"
        },
        "home_improvement_spend_12m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Improvement Spend 12M"
        },
        "utilities_spend_90d_monthly_avg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utilities Spend 90D Monthly Avg"
        },
        "utility_spend_trend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Utility Spend Trend"
        }
      },
      "title": "SpendFacts",
      "type": "object"
    },
    "VehicleFacts": {
      "additionalProperties": false,
      "properties": {
        "annual_mileage_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annual Mileage Km"
        },
        "fuel_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FuelType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
