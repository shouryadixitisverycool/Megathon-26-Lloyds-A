          "default": null,
          "title": "Record Updated At"
        },
        "vehicle_age_years": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Age Years"
        }
      },
      "title": "VehicleFacts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Point-in-time customer view.\n\n``features`` is the approved propensity feature view and is the single input\nused for model scoring. The typed fact groups are display/impact/guardrail\nviews of the same data. Audit-only attributes (age band, income band) are never\npresent here.",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "customer_id": {
      "title": "Customer Id",
      "type": "string"
    },
    "data_quality": {
      "$ref": "#/$defs/DataQualityEvidence"
    },
    "digital": {
      "$ref": "#/$defs/DigitalFacts"
    },
    "energy": {
      "$ref": "#/$defs/EnergyFacts"
    },
    "feature_cutoff": {
      "format": "date",
      "title": "Feature Cutoff",
      "type": "string"
    },
    "feature_version": {
      "title": "Feature Version",
      "type": "string"
    },
    "features": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Features",
      "type": "object"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "home": {
      "$ref": "#/$defs/HomeFacts"
    },
    "segment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Segment"
    },
    "spend": {
      "$ref": "#/$defs/SpendFacts"
    },
    "vehicle": {
      "$ref": "#/$defs/VehicleFacts"
    }
  },
  "required": [
    "customer_id",
    "feature_cutoff",
    "generated_at",
    "feature_version",
    "vehicle",
    "home",
    "energy",
    "digital",
    "spend",
    "features",
    "data_quality"
  ],
  "title": "CustomerSnapshot",
  "type": "object"
}
