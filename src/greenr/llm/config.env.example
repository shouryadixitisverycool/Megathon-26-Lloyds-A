# Nonsecret selected configuration. Keep API credentials out of this file.
# Selection does not mean live availability or quality has been evaluated.
GREENR_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-6-luna
LLM_MODEL_VERSION=gpt-6-luna
PROMPT_VERSION=grounded-selection-v1
# Empty temperature omits the request field; model support is unverified.
TEMPERATURE=
GREENR_LLM_TOKEN_LIMIT_PARAMETER=max_completion_tokens
MAX_OUTPUT_TOKENS=1600
GREENR_LLM_TIMEOUT_SECONDS=30
# Set OPENAI_API_KEY locally only when authorized; GREENR_LLM_API_KEY is a fallback.
# No key keeps the app offline. These settings already default from the manifest.
# Populate these from the provider's CURRENT pricing, in your chosen currency.
# Empty prices intentionally prevent the optional live evaluator from running.
GREENR_LLM_INPUT_PRICE_PER_MILLION=
GREENR_LLM_OUTPUT_PRICE_PER_MILLION=
GREENR_LLM_CACHED_INPUT_PRICE_PER_MILLION=
