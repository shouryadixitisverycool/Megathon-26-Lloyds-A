{
  "$defs": {
    "ConfidenceBucket": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ],
      "title": "ConfidenceBucket",
      "type": "string"
    },
    "ConfidenceResult": {
      "additionalProperties": false,
      "description": "Validated reliability of a displayed propensity (spec 16). Not eligibility.",
      "properties": {
        "bucket": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfidenceBucket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConfidenceStatus"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status",
        "method_version"
      ],
      "title": "ConfidenceResult",
      "type": "object"
    },
    "ConfidenceStatus": {
      "enum": [
        "VALIDATED",
        "SUPPRESSED"
      ],
      "title": "ConfidenceStatus",
      "type": "string"
    },
    "Eligibility": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "default": "Propensity does not establish financial eligibility.",
          "title": "Message",
          "type": "string"
        },
        "status": {
          "const": "NOT_ASSESSED",
          "default": "NOT_ASSESSED",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Eligibility",
      "type": "object"
    },
    "ImpactAssumption": {
      "additionalProperties": false,
      "properties": {
        "is_estimated": {
          "default": false,
          "title": "Is Estimated",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "ImpactAssumption",
      "type": "object"
    },
    "ImpactMetric": {
      "additionalProperties": false,
      "description": "Non-carbon outcome measure, e.g. paper statements avoided per year.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "ImpactMetric",
      "type": "object"
    },
    "ImpactResult": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/ImpactAssumption"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "boundary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Boundary"
        },
        "calculation_timestamp": {
          "format": "date-time",
          "title": "Calculation Timestamp",
          "type": "string"
        },
        "carbon_engine_version": {
          "title": "Carbon Engine Version",
          "type": "string"
        },
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "data_cutoff": {
          "format": "date",
          "title": "Data Cutoff",
          "type": "string"
        },
        "estimated_reduction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Reduction"
        },
        "factor_ids": {
          "items": {
            "type": "string"
          },
          "title": "Factor Ids",
          "type": "array"
        },
        "factor_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factor Source"
        },
        "factor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factor Version"
        },
        "grid_scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grid Scenario"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "methodology_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Methodology Id"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "scenario": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario"
        },
        "secondary_metrics": {
          "items": {
            "$ref": "#/$defs/ImpactMetric"
          },
          "title": "Secondary Metrics",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ImpactStatus"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "customer_id",
        "product",
        "status",
        "method_version",
        "data_cutoff",
        "calculation_timestamp",
        "carbon_engine_version"
      ],
      "title": "ImpactResult",
      "type": "object"
    },
    "ImpactStatus": {
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "NOT_CLAIMED"
      ],
      "title": "ImpactStatus",
      "type": "string"
    },
    "Priority": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "$ref": "#/$defs/PriorityComponents"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "score",
        "version",
        "components"
      ],
      "title": "Priority",
      "type": "object"
    },
    "PriorityComponents": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "normalised_impact": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalised Impact"
        },
        "propensity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Propensity",
          "type": "number"
        },
        "trust": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Trust",
          "type": "number"
        }
      },
      "required": [
        "propensity",
        "confidence",
        "normalised_impact",
        "trust"
      ],
      "title": "PriorityComponents",
      "type": "object"
    },
    "Product": {
      "enum": [
        "EV_FINANCE",
        "GREEN_HOME",
        "SOLAR_FINANCE",
        "PAPERLESS_BANKING"
      ],
      "title": "Product",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "HIGH_FUEL_SPEND",
        "HIGH_ANNUAL_MILEAGE",
        "ICE_VEHICLE_OWNER",
        "OLDER_VEHICLE",
        "HIGH_ELECTRICITY_USE",
        "HOMEOWNER",
        "MORTGAGE_CUSTOMER",
        "NO_EXISTING_SOLAR",
        "PAPER_STATEMENTS_ACTIVE",
        "HIGH_DIGITAL_ENGAGEMENT",
        "RECENT_HOME_IMPROVEMENT_SPEND",
        "UTILITY_SPEND_RISING",
        "EXISTING_VEHICLE_FINANCE",
        "HIGH_GAS_USE",
        "STATED_SUSTAINABILITY_PREFERENCE"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RecommendationState": {
      "enum": [
        "RECOMMEND",
        "DO_NOT_RECOMMEND",
        "INSUFFICIENT_INFORMATION",
        "CONFLICT_REQUIRES_REVIEW",
        "NOT_APPLICABLE",
        "SUPPRESSED"
      ],
      "title": "RecommendationState",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TrustAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Completeness",
          "type": "number"
        },
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "critical_fields_present": {
          "title": "Critical Fields Present",
          "type": "boolean"
        },
        "cross_source_consistency": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cross Source Consistency",
          "type": "number"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "freshness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Freshness",
          "type": "number"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/TrustIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "method_version": {
          "title": "Method Version",
          "type": "string"
        },
        "ood_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Ood Score",
          "type": "number"
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/TrustStatus"
        }
      },
      "required": [
        "customer_id",
        "product",
        "score",
        "status",
        "completeness",
        "freshness",
        "cross_source_consistency",
        "critical_fields_present",
        "ood_score",
        "method_version",
        "assessed_at"
      ],
      "title": "TrustAssessment",
      "type": "object"
    },
    "TrustIssue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/TrustIssueCategory"
        },
        "code": {
          "$ref": "#/$defs/TrustIssueCode"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "category",
        "severity",
        "message"
      ],
      "title": "TrustIssue",
      "type": "object"
    },
    "TrustIssueCategory": {
      "enum": [
        "COMPLETENESS",
        "FRESHNESS",
        "CONFLICT",
        "OOD",
        "CRITICAL_FIELD"
      ],
      "title": "TrustIssueCategory",
      "type": "string"
    },
    "TrustIssueCode": {
      "enum": [
        "SHORT_TRANSACTION_HISTORY",
        "HOME_OWNERSHIP_UNKNOWN",
        "VEHICLE_RECORD_MISSING",
        "VEHICLE_RECORD_STALE",
        "MILEAGE_MISSING",
        "MILEAGE_ESTIMATED",
        "ENERGY_RECORDS_MISSING",
        "ENERGY_RECORDS_INCOMPLETE",
        "DIGITAL_RECORDS_MISSING",
        "REGION_MISSING",
        "SUSTAINABILITY_PREFERENCE_UNKNOWN",
        "EV_RECORD_WITH_RECURRING_FUEL_SPEND",
        "NON_OWNER_WITH_ACTIVE_MORTGAGE",
        "PAPERLESS_FLAG_WITH_PAPER_STATEMENTS",
        "INVALID_PRODUCT_RECORD",
        "OUT_OF_DISTRIBUTION"
      ],
      "title": "TrustIssueCode",
      "type": "string"
    },
    "TrustStatus": {
      "enum": [
        "HIGH",
        "ADEQUATE",
        "LOW",
        "INSUFFICIENT"
      ],
      "title": "TrustStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calibration_version": {
      "title": "Calibration Version",
      "type": "string"
    },
    "carbon_engine_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Carbon Engine Version"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceResult"
    },
    "confidence_method_version": {
      "title": "Confidence Method Version",
      "type": "string"
    },
    "conflict_codes": {
      "items": {
        "type": "string"
      },
      "title": "Conflict Codes",
      "type": "array"
    },
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "customer_id": {
      "title": "Customer Id",
      "type": "string"
    },
    "data_cutoff": {
      "format": "date",
      "title": "Data Cutoff",
      "type": "string"
    },
    "eligibility": {
      "$ref": "#/$defs/Eligibility"
    },
    "emission_factor_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Emission Factor Version"
    },
    "evidence": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Evidence",
      "type": "object"
    },
    "exclusions": {
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "feature_version": {
      "title": "Feature Version",
      "type": "string"
    },
    "guardrail_codes": {
      "items": {
        "type": "string"
      },
      "title": "Guardrail Codes",
      "type": "array"
    },
    "impact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImpactResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "llm_model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Model Version"
    },
    "opportunity_id": {
      "$ref": "#/$defs/Product"
    },
    "outcome_window_end": {
      "format": "date",
      "title": "Outcome Window End",
      "type": "string"
    },
    "prediction_timestamp": {
      "format": "date-time",
      "title": "Prediction Timestamp",
      "type": "string"
    },
    "priority": {
      "anyOf": [
        {
          "$ref": "#/$defs/Priority"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "product_id": {
      "title": "Product Id",
      "type": "string"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "propensity": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Propensity",
      "type": "number"
    },
    "propensity_model_version": {
      "title": "Propensity Model Version",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "recommendation_id": {
      "title": "Recommendation Id",
      "type": "string"
    },
    "recommendation_rule_version": {
      "title": "Recommendation Rule Version",
      "type": "string"
    },
    "recommendation_status": {
      "$ref": "#/$defs/RecommendationState"
    },
    "trust": {
      "$ref": "#/$defs/TrustAssessment"
    },
    "trust_method_version": {
      "title": "Trust Method Version",
      "type": "string"
    }
  },
  "required": [
    "recommendation_id",
    "customer_id",
    "opportunity_id",
    "product_id",
    "propensity",
    "propensity_model_version",
    "calibration_version",
    "confidence",
    "trust",
    "recommendation_status",
    "data_cutoff",
    "outcome_window_end",
    "prediction_timestamp",
    "feature_version",
    "confidence_method_version",
    "trust_method_version",
    "recommendation_rule_version"
  ],
  "title": "Recommendation",
  "type": "object"
}
