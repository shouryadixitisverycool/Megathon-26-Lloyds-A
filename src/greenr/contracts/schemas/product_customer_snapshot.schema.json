{
  "$defs": {
    "CustomerSnapshot": {
      "additionalProperties": false,
      "description": "Point-in-time customer view.\n\n``features`` is the approved propensity feature view and is the single input\nused for model scoring. The typed fact groups are display/impact/guardrail\nviews of the same data. Audit-only attributes (age band, income band) are never\npresent here.",
      "properties": {
        "contract_version": {
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "customer_id": {
          "title": "Customer Id",
          "type": "string"
        },
        "data_quality": {
          "$ref": "#/$defs/DataQualityEvidence"
        },
        "digital": {
          "$ref": "#/$defs/DigitalFacts"
        },
        "energy": {
          "$ref": "#/$defs/EnergyFacts"
        },
        "feature_cutoff": {
          "format": "date",
          "title": "Feature Cutoff",
          "type": "string"
        },
        "feature_version": {
          "title": "Feature Version",
          "type": "string"
        },
        "features": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Features",
          "type": "object"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "home": {
          "$ref": "#/$defs/HomeFacts"
        },
        "segment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment"
        },
        "source_events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceUpdateRequest"
          },
          "title": "Source Events",
          "type": "array"
        },
        "source_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Versions",
          "type": "object"
        },
        "spend": {
          "$ref": "#/$defs/SpendFacts"
        },
        "vehicle": {
          "$ref": "#/$defs/VehicleFacts"
        }
      },
      "required": [
        "customer_id",
        "feature_cutoff",
        "generated_at",
        "feature_version",
        "vehicle",
        "home",
        "energy",
        "digital",
        "spend",
        "features",
        "data_quality"
      ],
      "title": "CustomerSnapshot",
      "type": "object"
    },
    "DataQualityEvidence": {
      "additionalProperties": false,
      "properties": {
        "digital_months_present": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Digital Months Present",
          "type": "integer"
        },
        "energy_months_present": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Energy Months Present",
          "type": "integer"
        },
        "estimated_fields": {
          "items": {
            "type": "string"
          },
          "title": "Estimated Fields",
          "type": "array"
        },
        "first_transaction_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Transaction Date"
        },
        "invalid_product_records": {
          "default": 0,
          "minimum": 0,
          "title": "Invalid Product Records",
          "type": "integer"
        },
        "last_transaction_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Transaction Date"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "transaction_months_observed": {
          "minimum": 0,
          "title": "Transaction Months Observed",
          "type": "integer"
        },
        "vehicle_record_age_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Record Age Days"
        }
      },
      "required": [
        "transaction_months_observed"
      ],
      "title": "DataQualityEvidence",
      "type": "object"
    },
    "DigitalFacts": {
      "additionalProperties": false,
      "properties": {
        "branch_visits_3m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
