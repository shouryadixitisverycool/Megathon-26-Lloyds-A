            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Paperless"
        },
        "paper_statements_12m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Statements 12M"
        },
        "paper_statements_3m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Statements 3M"
        },
        "paper_statements_post_paperless_3m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Statements Post Paperless 3M"
        },
        "paperless_effective_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paperless Effective At"
        }
      },
      "title": "DigitalFacts",
      "type": "object"
    },
    "EnergyFacts": {
      "additionalProperties": false,
